+        static bool usesBoundlessRange(const RenderDeviceCapabilities &capabilities) {
+            return capabilities.descriptorIndexing;
+        }
+
+        FramebufferRendererDescriptorTextureSet(bool boundless, RenderDevice *device = nullptr, uint32_t textureCacheSize = 0) {
+            this->boundless = boundless;
+
+            // A fixed table already holds every slot, so it never has to grow with the cache.
+            this->textureCacheSize = boundless ? textureCacheSize : UpperRange;
 
             builder.begin();
