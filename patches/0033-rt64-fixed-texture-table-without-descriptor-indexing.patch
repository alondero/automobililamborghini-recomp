-            builder.end(true, textureCacheSize);
+            builder.end(boundless, boundless ? textureCacheSize : 0);
 
             if (device != nullptr) {
                 create(device);
             }
         }
+
+        // Without partially bound descriptors, every slot of a fixed table must stay valid even
+        // when no texture uses it. Variable-size tables leave unused slots untouched.
+        void clearSlot(uint32_t index, const RenderTexture *placeholder) {
+            if (!boundless) {
+                setTexture(index, placeholder, RenderTextureLayout::SHADER_READ);
+            }
+        }
+
+        void clearAllSlots(const RenderTexture *placeholder) {
+            for (uint32_t i = 0; !boundless && (i < UpperRange); i++) {
+                clearSlot(i, placeholder);
+            }
+        }
     };
 
