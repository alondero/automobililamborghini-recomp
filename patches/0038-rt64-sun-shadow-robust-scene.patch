diff --git a/src/render/rt64_sun_shadow_cache.cpp b/src/render/rt64_sun_shadow_cache.cpp
new file mode 100644
index 0000000..16a81c9
--- /dev/null
+++ b/src/render/rt64_sun_shadow_cache.cpp
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 RT64 Contributors
+#include "rt64_sun_shadow_cache.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstring>
+
+namespace RT64 {
+    namespace {
+        // Shared by every cache, so a replaced cache never reissues a version
+        // that its owner already built.
+        std::atomic<uint64_t> versions{ 0 };
+
+        float distanceSquared(const SunShadowStaticCache::Triangle &triangle, const float eye[3]) {
+            float sum = 0.0f;
+            for (int axis = 0; axis < 3; axis++) {
+                const float centroid = (triangle[axis] + triangle[3 + axis] + triangle[6 + axis]) / 3.0f;
+                const float delta = centroid - eye[axis];
+                sum += delta * delta;
+            }
+            return sum;
+        }
+
+        bool finite(const SunShadowStaticCache::Triangle &triangle) {
+            for (float value : triangle) {
+                if (!std::isfinite(value)) return false;
+            }
+            return true;
+        }
+    };
+
+    bool SunShadowStaticCache::Key::operator==(const Key &other) const {
+        return std::memcmp(bits.data(), other.bits.data(), sizeof(Triangle)) == 0;
+    }
+
+    size_t SunShadowStaticCache::KeyHash::operator()(const Key &key) const {
+        uint32_t words[9];
+        std::memcpy(words, key.bits.data(), sizeof(words));
+        uint64_t hash = 1469598103934665603ULL;
+        for (uint32_t word : words) {
+            hash ^= word;
+            hash *= 1099511628211ULL;
+        }
+        return size_t(hash ^ (hash >> 32));
+    }
+
+    void SunShadowStaticCache::reset() {
+        entries_.clear();
+        promoted_ = 0;
+        prunedTask_ = 0;
+        if (!published_.empty()) {
+            published_.clear();
+            version_ = ++versions;
+        }
+    }
+
+    void SunShadowStaticCache::observe(uint64_t epoch, uint64_t task, const std::vector<Triangle> &triangles, const float eye[3]) {
+        if (!started_ || (epoch != epoch_)) {
+            reset();
+            epoch_ = epoch;
+            started_ = true;
+        }
+
+        for (const Triangle &triangle : triangles) {
+            if (!finite(triangle)) continue;
+            auto inserted = entries_.try_emplace(Key{ triangle });
+            Entry &entry = inserted.first->second;
+            if (!inserted.second && !entry.promoted && (task > entry.lastTask) && (task - entry.lastTask <= settings_.promoteGap)) {
+                entry.promoted = true;
+                promoted_++;
+            }
+
+            entry.lastTask = std::max(entry.lastTask, task);
+        }
+
+        const uint32_t interval = std::max(settings_.pruneInterval, 1U);
+        if ((task - prunedTask_ >= interval) || (promoted_ > settings_.maxTriangles)) {
+            prune(task, eye);
+        }
+
+        publish(task);
+    }
+
+    void SunShadowStaticCache::prune(uint64_t task, const float eye[3]) {
+        prunedTask_ = task;
+        const float radiusSquared = settings_.radius * settings_.radius;
+        for (auto it = entries_.begin(); it != entries_.end();) {
+            const uint64_t unseen = task > it->second.lastTask ? task - it->second.lastTask : 0;
+            bool erase = false;
+            if (!it->second.promoted) {
+                erase = unseen > settings_.promoteGap;
+            }
+            else if ((unseen > settings_.keepTasks) && (distanceSquared(it->first.bits, eye) > radiusSquared)) {
+                erase = true;
+                promoted_--;
+            }
+
+            it = erase ? entries_.erase(it) : std::next(it);
+        }
+
+        if (promoted_ <= settings_.maxTriangles) return;
+
+        // Over the cap: keep the scenery nearest the camera.
+        std::vector<std::pair<float, Key>> ranked;
+        ranked.reserve(promoted_);
+        for (const auto &entry : entries_) {
+            if (entry.second.promoted) ranked.emplace_back(distanceSquared(entry.first.bits, eye), entry.first);
+        }
+
+        auto keep = ranked.begin() + settings_.maxTriangles;
+        std::nth_element(ranked.begin(), keep, ranked.end(), [](const auto &a, const auto &b) { return a.first < b.first; });
+        for (auto it = keep; it != ranked.end(); it++) {
+            entries_.erase(it->second);
+        }
+
+        promoted_ = settings_.maxTriangles;
+    }
+
+    void SunShadowStaticCache::publish(uint64_t task) {
+        next_.clear();
+        for (const auto &entry : entries_) {
+            if (entry.second.promoted && (settings_.includePresented || (entry.second.lastTask != task))) {
+                next_.push_back(entry.first.bits);
+            }
+        }
+
+        if (next_ != published_) {
+            published_.swap(next_);
+            version_ = ++versions;
+        }
+    }
+};
diff --git a/src/render/rt64_sun_shadow_cache.h b/src/render/rt64_sun_shadow_cache.h
new file mode 100644
index 0000000..cbe75a6
--- /dev/null
+++ b/src/render/rt64_sun_shadow_cache.h
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 RT64 Contributors
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <unordered_map>
+#include <vector>
+
+namespace RT64 {
+// Static scenery remembered across Workloads. A view only presents what the
+// camera sees, so casters behind or beside it would otherwise vanish and their
+// shadows would change with the viewpoint. Triangles are world-space float
+// positions; a triangle becomes static once the same bits are presented in two
+// tasks at most promoteGap apart, which moving geometry never repeats.
+// Promoted triangles far from the camera and unseen for keepTasks are evicted.
+// CPU only: the owner uploads published() and builds its own structure.
+struct SunShadowStaticCacheSettings {
+    uint32_t maxTriangles = 131072;
+    uint32_t promoteGap = 2;
+    uint32_t keepTasks = 300;
+    float radius = 400.0f; // World units from the camera.
+    uint32_t pruneInterval = 30; // Tasks between eviction passes.
+    // Publish presented scenery too. A diagnostic: the owner then traces the
+    // remembered scenery in place of the presented world.
+    bool includePresented = false;
+};
+
+class SunShadowStaticCache {
+public:
+    using Triangle = std::array<float, 9>;
+
+    explicit SunShadowStaticCache(SunShadowStaticCacheSettings settings = {}) : settings_(settings) {}
+    // Records one task's static casters. A new epoch starts an empty cache.
+    void observe(uint64_t epoch, uint64_t task, const std::vector<Triangle> &triangles, const float eye[3]);
+    // Promoted triangles that the last observed task did not present: the
+    // view traces those it presents itself, and a duplicate would only slow
+    // every ray. version() is 0 until the first snapshot, changes with the
+    // contents and never repeats, even across epochs or cache instances.
+    const std::vector<Triangle> &published() const { return published_; }
+    uint64_t version() const { return version_; }
+    size_t promoted() const { return promoted_; }
+    size_t candidates() const { return entries_.size() - promoted_; }
+    void reset();
+
+private:
+    struct Key {
+        Triangle bits;
+        bool operator==(const Key &other) const;
+    };
+    struct KeyHash {
+        size_t operator()(const Key &key) const;
+    };
+    struct Entry {
+        uint64_t lastTask = 0;
+        bool promoted = false;
+    };
+    void prune(uint64_t task, const float eye[3]);
+    void publish(uint64_t task);
+
+    SunShadowStaticCacheSettings settings_;
+    std::unordered_map<Key, Entry, KeyHash> entries_;
+    std::vector<Triangle> published_, next_;
+    uint64_t epoch_ = 0;
+    uint64_t version_ = 0;
+    uint64_t prunedTask_ = 0;
+    size_t promoted_ = 0;
+    bool started_ = false;
+};
+}
