+namespace recompui {
+
+// A prompt is a modal overlay, so the Back menu action must dismiss it the same way
+// its cancel button does. Controller presses arrive as MenuAction::Back because
+// menu_action_mapping resolves the pressing device's current Back binding first, so a
+// remapped cancel button is honored without naming a physical button here.
+//
+// Dispatch: RmlUi sends a keydown to the focused element and walks GetParentNode() up
+// to that element's document root. This element is an ancestor of the prompt's buttons
+// and the only one in the tree that listens for menu actions, so it is reached exactly
+// once per press, in the bubble phase, and the walk cannot leave the prompt's document
+// to reach the page underneath. The prompt focuses one of its own buttons when it
+// opens, which is what starts the walk inside the prompt. Hiding the context blurs the
+// document, so a held button's key repeat is dispatched from the page underneath, where
+// Back has no callback.
+class PromptWindow : public Element {
+    void process_event(const Event &e) override {
+        if (e.type != EventType::MenuAction) {
+            return;
+        }
+
+        if (std::get<EventMenuAction>(e.variant).action == MenuAction::Back) {
+            run_cancel_callback();
+        }
+    }
+    std::string_view get_type_name() override { return "PromptWindow"; }
+public:
+    PromptWindow(ResourceId rid, Element* parent) : Element(rid, parent, Events(EventType::MenuAction), "div", false) {
+    }
+};
+
+} // namespace recompui
