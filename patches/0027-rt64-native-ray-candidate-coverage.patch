 }
 
+// Existing opaque-only callers have no alpha resources. A tagged candidate
+// returns native visibility rather than silently turning a cutout into a solid.
+float SunShadowVisibility(RaytracingAccelerationStructure scene,
+    StructuredBuffer<uint4> geometry, float3 position, float3 geometricNormal,
+    uint receiverDraw, uint receiverFaceStart, SunShadowParams p)
+{
+    bool coverageValid;
+    return SunShadowVisibility(scene, geometry, position, geometricNormal,
+        receiverDraw, receiverFaceStart, p, coverageValid);
+}
