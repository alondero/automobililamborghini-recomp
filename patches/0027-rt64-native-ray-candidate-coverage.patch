diff --git a/src/shaders/NativeRayHit.hlsli b/src/shaders/NativeRayHit.hlsli
new file mode 100644
index 0000000..7f3c1b8
--- /dev/null
+++ b/src/shaders/NativeRayHit.hlsli
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 RT64 Contributors
+#pragma once
+
+#include "NativeMaterial.hlsli"
+
+struct NativeHitAttributes {
+    float4 position;
+    float2 uv;
+    float2 dx;
+    float2 dy;
+    float4 shade;
+};
+
+// Varying shade alpha can straddle a native discard boundary because raster
+// interpolation and triangle-hit barycentrics have different rounding. No error
+// bound is authenticated yet, so those alpha paths and stochastic alpha compare
+// remain unsupported. Receiver fog alpha still runs in the native raster path.
+bool NativeRayCoverageInputsSupported(RenderParams rp, float4 shade[3]) {
+    const OtherMode mode = {rp.omL, rp.omH};
+    if (mode.alphaCompare() == G_AC_DITHER) return false;
+    if (!mode.cvgXAlpha() && mode.alphaCompare() == G_AC_NONE) return true;
+    if (shade[0].a == shade[1].a && shade[0].a == shade[2].a) return true;
+    const ColorCombiner combiner = {rp.ccL, rp.ccH};
+    const uint cycles = combiner.cycleCount(mode);
+    for (uint cycle = 0; cycle < cycles; ++cycle) {
+        const bool second = cycles == 1 || cycle == 1;
+        for (uint input = 0; input < 4; ++input)
+            if (combiner.decodeAlphaInput(input, second) == ColorCombiner::A_SHADE) return false;
+    }
+    return true;
+}
+
+float NativeCross2(float2 a, float2 b) {
+    return a.x * b.y - a.y * b.x;
+}
+
+float3 NativeScreenBarycentric(float2 pixel, float2 a, float2 b, float2 c, float determinant) {
+    float2 delta = pixel - a;
+    float y = NativeCross2(delta, c - a) / determinant;
+    float z = NativeCross2(b - a, delta) / determinant;
+    return float3(1 - y - z, y, z);
+}
+
+// Reconstruct the generated raster attributes at a world-space triangle hit.
+// Input positions are RSPProcessCS output, not guest vertices or live transforms.
+// viewport and scale/offset are the exact displayed draw's RasterVS values.
+// Behind-eye/degenerate/non-finite inputs are unsupported, never solid cutouts.
+// Coarse 2x2 UV differences match the DXIL raster derivative instructions; the
+// selected backend still needs raster-versus-hit validation before admission.
+bool NativeRayHitAttributes(RenderParams rp, float3 worldBarycentric,
+    float4 screen[3], float2 uv[3], float4 shade[3],
+    float4 viewport, float2 screenScale, float2 screenOffset,
+    out NativeHitAttributes attributes)
+{
+    attributes = (NativeHitAttributes)0;
+    if (renderFlagRect(rp.flags) || !all(isfinite(worldBarycentric)) ||
+        any(worldBarycentric < -1e-5f) || abs(dot(worldBarycentric, 1.0f) - 1) > 1e-4f ||
+        !all(isfinite(viewport)) || any(viewport.zw <= 0) ||
+        !all(isfinite(screenScale)) || !all(isfinite(screenOffset)) ||
+        any(FbParams.resolution <= 0)) return false;
+    float2 pixel[3];
+    float3 w = float3(screen[0].w, screen[1].w, screen[2].w);
+    if (!all(isfinite(w)) || any(w <= 1e-6f)) return false;
+    for (uint i = 0; i < 3; ++i) {
+        if (!all(isfinite(screen[i])) || !all(isfinite(uv[i])) || !all(isfinite(shade[i]))) return false;
+        float2 ndc = (screen[i].xy - FbParams.resolution / 2) /
+            float2(FbParams.resolution.x / 2, -FbParams.resolution.y / 2);
+        ndc = ndc * screenScale + screenOffset;
+        pixel[i] = viewport.xy + viewport.zw / 2 + ndc * viewport.zw * float2(0.5f, -0.5f);
+    }
+    float determinant = NativeCross2(pixel[1] - pixel[0], pixel[2] - pixel[0]);
+    if (!isfinite(determinant) || abs(determinant) < 1e-8f) return false;
+    const OtherMode mode = {rp.omL, rp.omH};
+    float2 extent = max(max(pixel[0], pixel[1]), pixel[2]) - min(min(pixel[0], pixel[1]), pixel[2]);
+    // A measured subpixel LOD fixture disagrees with native raster derivatives.
+    // Keep that unvalidated footprint unsupported, rather than asserting parity.
+    if (mode.textLOD() == G_TL_LOD && any(extent < 1)) return false;
+    float hitW = dot(worldBarycentric, w);
+    float3 screenBarycentric = worldBarycentric * w / hitW;
+    float2 hitPixel = screenBarycentric.x * pixel[0] + screenBarycentric.y * pixel[1] +
+        screenBarycentric.z * pixel[2];
+    float2 quad = floor(hitPixel / 2) * 2 + 0.5f;
+    float3 weights[3];
+    weights[0] = NativeScreenBarycentric(quad, pixel[0], pixel[1], pixel[2], determinant) / w;
+    weights[1] = NativeScreenBarycentric(quad + float2(1, 0), pixel[0], pixel[1], pixel[2], determinant) / w;
+    weights[2] = NativeScreenBarycentric(quad + float2(0, 1), pixel[0], pixel[1], pixel[2], determinant) / w;
+    float2 quadUV[3];
+    for (uint j = 0; j < 3; ++j) {
+        float divisor = dot(weights[j], 1.0f);
+        if (!isfinite(divisor) || divisor <= 1e-8f) return false;
+        weights[j] /= divisor;
+        quadUV[j] = weights[j].x * uv[0] + weights[j].y * uv[1] + weights[j].z * uv[2];
+    }
+    attributes.uv = worldBarycentric.x * uv[0] + worldBarycentric.y * uv[1] + worldBarycentric.z * uv[2];
+    attributes.dx = quadUV[1] - quadUV[0];
+    attributes.dy = quadUV[2] - quadUV[0];
+    attributes.shade = worldBarycentric.x * shade[0] + worldBarycentric.y * shade[1] + worldBarycentric.z * shade[2];
+    if (!renderFlagSmoothShade(rp.flags)) attributes.shade.rgb = shade[0].rgb;
+    attributes.position = float4(hitPixel, dot(screenBarycentric,
+        float3(screen[0].z, screen[1].z, screen[2].z)), 1 / hitW);
+    return all(isfinite(attributes.uv)) && all(isfinite(attributes.dx)) &&
+        all(isfinite(attributes.dy)) && all(isfinite(attributes.shade)) && all(isfinite(attributes.position));
+}
