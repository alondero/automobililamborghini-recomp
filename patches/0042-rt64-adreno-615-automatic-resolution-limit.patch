 #define ENABLE_HIGH_RESOLUTION_RENDERER 1
 
 namespace RT64 {
+    static bool needsAdreno615ResolutionLimit(const RenderDeviceDescription &deviceDescription) {
+#if defined(__ANDROID__)
+        // Only this system-driver combination has been reproduced. Turnip and
+        // other Adreno devices must retain their normal automatic scale.
+        return (uint32_t(deviceDescription.vendor) == 0x5143)
+            && (deviceDescription.driverVersion == 0x801f6000)
+            && (deviceDescription.name == "Adreno (TM) 615");
+#else
+        return false;
+#endif
+    }
+
+    static float automaticResolutionScale(uint32_t height, uint32_t referenceHeight, const RenderDeviceDescription &deviceDescription) {
+        float scale = (height > 0) ? std::max(float((height + referenceHeight - 1) / referenceHeight), 1.0f) : 1.0f;
+        // A 6x window scale loses the device during startup on the SM-T720's
+        // 2020 system driver; 2x reaches the attract race. This is a bounded
+        // workaround, not a diagnosis of the driver's internal GPU fault.
+        // See docs/ANDROID.md in the port for the measurements and limits.
+        return needsAdreno615ResolutionLimit(deviceDescription) ? std::min(scale, 2.0f) : scale;
+    }
+
