+    // Largest integer scale whose presented pixel rate fits the budget. The
+    // display refresh target multiplies the work as much as the resolution
+    // does, so both are bounded together. With an unknown game rate, assume 30.
+    static float automaticResolutionBudgetScale(uint32_t referenceHeight, float aspectRatioTarget, uint32_t targetRate, uint32_t viOriginalRate) {
+        // An Adreno 650 with MSAA2X kept every 60 Hz interpolated frame at
+        // 1.25 Mpixels per frame (75 Mpixels/s) and dropped a fifth at 2.2.
+        // See docs/ANDROID.md in the port for the measurements.
+        const double PixelsPerSecond = 80.0e6;
+        const double presentRate = std::max({ targetRate, viOriginalRate, 30U });
+        const double pixelsAtNativeScale = double(referenceHeight) * double(referenceHeight) * aspectRatioTarget;
+        return std::max(float(std::floor(std::sqrt(PixelsPerSecond / (pixelsAtNativeScale * presentRate)))), 1.0f);
+    }
