--- /dev/null
+++ b/recompui/src/core/ui_debugger.h
@@ -0,0 +1,21 @@
+#pragma once
+#include <RmlUi/Debugger.h>
+
+namespace recompui::detail {
+// Sample the developer option at startup. A disabled debugger must not install
+// its diagnostic listener or create its beacon; the system logger stays active.
+class UiDebugger {
+    bool initialized = false;
+public:
+    void initialise(Rml::Context* context, bool enabled) {
+        initialized = enabled && Rml::Debugger::Initialise(context);
+    }
+    void toggle() {
+        if (initialized) Rml::Debugger::SetVisible(!Rml::Debugger::IsVisible());
+    }
+    void shutdown() {
+        if (initialized) Rml::Debugger::Shutdown();
+        initialized = false;
+    }
+};
+}
