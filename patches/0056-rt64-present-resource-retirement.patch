+    bool PresentQueue::threadAcquire(uint32_t &swapChainIndex, bool &swapChainValid) {
+        const bool acquired = ext.swapChain->acquireTexture(acquiredSemaphore.get(), &swapChainIndex);
+        swapChainValid = acquired || ext.swapChain->isAcquisitionRetryable();
+        return acquired; // No draw/submission/present without an acquired image.
+    }
+
+    void PresentQueue::releaseSwapChainResources() {
+        if (swapChainFramebuffers.empty() && drawSemaphores.empty() && !acquiredSemaphore) return;
+        const auto drained = ext.swapChain ? ext.swapChain->drain() : RenderSwapChain::DrainResult::Failed;
+        if (drained == RenderSwapChain::DrainResult::Failed) {
+            // Completion is unknown. Leak the wrappers as well as their GPU objects;
+            // leaving unique_ptrs here would destroy them when PresentQueue dies.
+            for (auto &framebuffer : swapChainFramebuffers) framebuffer.release();
+            for (auto &semaphore : drawSemaphores) semaphore.release();
+            acquiredSemaphore.release();
+        }
+        swapChainFramebuffers.clear();
+        drawSemaphores.clear();
+        acquiredSemaphore.reset();
+    }
+
+    void PresentQueue::threadResize(bool &swapChainValid) {
+        // Complete rendering and apply backend WSI teardown before retiring attachments.
+        // Frontend rendering uses these same framebuffers through the draw hook.
+        ext.presentGraphicsWorker->commandList->begin();
+        ext.presentGraphicsWorker->commandList->end();
+        ext.presentGraphicsWorker->execute();
+        ext.presentGraphicsWorker->wait();
+        if (ext.swapChain->drain() != RenderSwapChain::DrainResult::Complete) {
+            swapChainValid = false;
+            return; // Keep attachments and semaphores alive for a later retry.
+        }
+        swapChainFramebuffers.clear();
+        drawSemaphores.clear();
+        acquiredSemaphore.reset();
+        swapChainValid = ext.swapChain->resize();
+
+        // A failed present may leave a signalled, unconsumed semaphore. Allocate fresh
+        // synchronization objects after the drain, including on a failed recreation.
+        acquiredSemaphore = ext.device->createCommandSemaphore();
+        if (swapChainValid) {
+            ext.sharedResources->setSwapChainSize(ext.swapChain->getWidth(), ext.swapChain->getHeight());
+            while (drawSemaphores.size() < ext.swapChain->getTextureCount()) {
+                drawSemaphores.emplace_back(ext.device->createCommandSemaphore());
+            }
+        }
+    }
+
