+#pragma once
+#include <array>
+#include <string>
+#include <vector>
+#include "shared/rt64_native_alpha_evidence.h"
+
+namespace RT64 {
+struct RenderWorker;
+struct FramebufferRenderer;
+struct Workload;
+
+struct NativeAlphaVertexShaderEvidence {
+    uint32_t renderIndex = 0;
+    std::vector<uint8_t> dxil;
+};
+
+// Diagnostic only, called after the Workload fence while the worker and texture
+// cache remain exclusively owned. References never escape this call. It submits
+// isolated native triangles into its own color/depth targets, compares interior
+// material coverage, waits, and releases all GPU resources after that fence.
+// This does not prove raster edges, ray intersection precision, blended objects,
+// receiver composition, or view readiness and cannot suppress native output.
+bool CheckNativeAlphaEvidence(RenderWorker *worker, const FramebufferRenderer &renderer,
+    uint32_t framebufferIndex, const Workload &workload,
+    const std::vector<std::array<float, 4>> &screen, const std::vector<uint32_t> &renderIndices,
+    std::vector<interop::NativeAlphaEvidenceResult> &results,
+    std::vector<NativeAlphaVertexShaderEvidence> &vertexShaders,
+    std::vector<std::array<float, 4>> &nativeClip, std::string &error);
+}
