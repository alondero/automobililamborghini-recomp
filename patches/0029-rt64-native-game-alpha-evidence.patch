@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 RT64 Contributors
+#pragma once
+#include "shared/rt64_hlsl.h"
+#ifdef HLSL_CPU
+namespace interop {
+#endif
+struct NativeAlphaEvidenceParams {
+    uint renderIndex, faceStart, resultIndex, reserved;
+    float2 screenScale, screenOffset;
+    float4 viewport;
+    int4 testRect;
+    uint2 targetSize, padding;
+};
+struct NativeAlphaEvidenceResult {
+    uint renderIndex, faceStart, tested, nativeCovered;
+    uint evaluatedCovered, disagreements, unsupported, firstMismatchPixel;
+    float4 sampleUVPosition, sampleDxDy, sampleAlphaDepthShade;
+    float4 nativeUVShadeAlpha, nativeDxDy;
+};
+#ifdef HLSL_CPU
+static_assert(sizeof(NativeAlphaEvidenceParams) == 80);
+static_assert(sizeof(NativeAlphaEvidenceResult) == 112);
+}
+#endif
