@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 RT64 Contributors
+#include "NativeMaterial.hlsli"
+#include "shared/rt64_raster_params.h"
+
+ConstantBuffer<RasterParams> gConstants : register(b0, space0);
+
+// Diagnostic inputs from the exact native vertex shader selected by the draw.
+// Material holes also write attributes into these isolated targets. The real
+// native owner pipeline separately supplies the authoritative discard result.
+void PSMain(float4 position : SV_POSITION, float2 uv : TEXCOORD,
+    float4 color : COLOR0, out float4 uvShadeAlpha : SV_TARGET0,
+    out float4 derivatives : SV_TARGET1) {
+    RenderIndices indices = instanceRenderIndices[gConstants.renderIndex];
+    RenderParams rp = DynamicRenderParams[indices.instanceIndex];
+    uint2 pixel = uint2(floor(position.xy));
+    uint seed = initRand(FrParams.frameCount, indices.instanceIndex * pixel.y * pixel.x, 16);
+    float4 shade, combined;
+    float alphaCompare, coverage;
+    float2 dx = ddx(uv), dy = ddy(uv);
+    EvaluateNativeMaterial(rp, indices, color, position, uv, dx, dy, seed,
+        shade, combined, alphaCompare, coverage);
+    uvShadeAlpha = float4(uv, color.a, combined.a);
+    derivatives = float4(dx, dy);
+}
