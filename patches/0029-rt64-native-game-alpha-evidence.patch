+#include "shared/rt64_native_alpha_evidence.h"
+ConstantBuffer<NativeAlphaEvidenceParams> Params : register(b0, space4);
+RWStructuredBuffer<float4> NativeClip : register(u1, space4);
+struct Vertex {
+    float4 position : SV_POSITION;
+    float2 uv : TEXCOORD;
+    float4 color : COLOR0;
+};
+// Capture the actual selected RasterVS outputs before clipping. The reference
+// ownership pass remains the unmodified native VS/PS, without this shader.
+[maxvertexcount(3)]
+void GSMain(triangle Vertex vertices[3], inout TriangleStream<Vertex> output) {
+    for (uint i = 0; i < 3; ++i) {
+        NativeClip[Params.resultIndex * 3 + i] = vertices[i].position;
+        output.Append(vertices[i]);
+    }
+}
