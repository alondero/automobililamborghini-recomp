diff --git a/src/shaders/NativeAlphaEvidenceCS.hlsl b/src/shaders/NativeAlphaEvidenceCS.hlsl
new file mode 100644
index 0000000..226e9b8
--- /dev/null
+++ b/src/shaders/NativeAlphaEvidenceCS.hlsl
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 RT64 Contributors
+#define NATIVE_HIT_D3D12_SNAP_PROBE
+#include "NativeRayHit.hlsli"
+#include "shared/rt64_native_alpha_evidence.h"
+
+ConstantBuffer<NativeAlphaEvidenceParams> Params : register(b0, space4);
+ByteAddressBuffer Faces : register(t0, space4);
+ByteAddressBuffer Screen : register(t1, space4);
+ByteAddressBuffer UV : register(t2, space4);
+ByteAddressBuffer Shade : register(t3, space4);
+Texture2D<uint2> NativeOwner : register(t4, space4);
+Texture2D<float4> NativeUV : register(t5, space4);
+Texture2D<float4> NativeDerivatives : register(t6, space4);
+StructuredBuffer<float4> NativeClip : register(t7, space4);
+RWStructuredBuffer<NativeAlphaEvidenceResult> Results : register(u0, space4);
+
+// Compare native RasterVS/RasterPS against reconstructed hit attributes using
+// the displayed draw's actual descriptor sets. Triangle isolation removes
+// inter-draw depth occlusion; clipping, culling and material discard remain.
+// Edge pixels are excluded from this diagnostic, never authenticated by it.
+[numthreads(8, 8, 1)]
+void CSMain(uint3 id : SV_DispatchThreadID) {
+    int2 pixel = Params.testRect.xy + int2(id.xy);
+    if (any(pixel >= Params.testRect.zw)) return;
+    RenderIndices indices = instanceRenderIndices[Params.renderIndex];
+    RenderParams rp = DynamicRenderParams[indices.instanceIndex];
+    float4 screen[3], shade[3], clip[3];
+    float2 uv[3], projected[3];
+    for (uint i = 0; i < 3; ++i) {
+        uint vertex = Faces.Load(4 * (Params.faceStart + i));
+        screen[i] = asfloat(Screen.Load4(vertex * 16));
+        clip[i] = NativeClip[Params.resultIndex * 3 + i];
+        uv[i] = asfloat(UV.Load2(vertex * 8));
+        shade[i] = asfloat(Shade.Load4(vertex * 16));
+        screen[i].z = clip[i].z / clip[i].w;
+        projected[i] = NativeHitD3D12ProjectedPixel(clip[i], Params.viewport);
+    }
+    NativeHitAttributes centerAttributes;
+    if (!NativeRayCoverageInputsSupported(rp, shade) ||
+        !NativeRayHitAttributes(rp, float3(1.0f/3, 1.0f/3, 1.0f/3), screen, uv, shade,
+            Params.viewport, Params.screenScale, Params.screenOffset, clip, centerAttributes)) {
+        if (all(id.xy == 0)) InterlockedAdd(Results[Params.resultIndex].unsupported, 1);
+        return;
+    }
+    float determinant = NativeCross2(projected[1] - projected[0], projected[2] - projected[0]);
+    float3 bary = NativeScreenBarycentric(float2(pixel) + 0.5f,
+        projected[0], projected[1], projected[2], determinant);
+    float3 edgeLength = float3(length(projected[2] - projected[1]),
+        length(projected[0] - projected[2]), length(projected[1] - projected[0]));
+    if (any(bary * abs(determinant) / edgeLength <= 1)) return;
+    float3 w = float3(screen[0].w, screen[1].w, screen[2].w);
+    float3 worldBary = bary / w;
+    worldBary /= dot(worldBary, 1.0f);
+    NativeHitAttributes attributes;
+    if (!NativeRayHitAttributes(rp, worldBary, screen, uv, shade,
+        Params.viewport, Params.screenScale, Params.screenOffset, clip, attributes)) {
+        InterlockedAdd(Results[Params.resultIndex].unsupported, 1);
+        return;
+    }
+    const OtherMode mode = {rp.omL, rp.omH};
+    bool clipped = attributes.position.z > 1022.0f / 1024.0f ||
+        (!renderFlagNoN(rp.flags) && attributes.position.z < 0);
+    bool culled = renderFlagCulling(rp.flags) && determinant >= 0;
+    uint2 seedPixel = uint2(floor(attributes.position.xy));
+    uint seed = initRand(FrParams.frameCount, indices.instanceIndex * seedPixel.y * seedPixel.x, 16);
+    float4 materialShade = 0, combined = 0;
+    float alphaCompare = 0, coverage = 0;
+    bool evaluated = !clipped && !culled && EvaluateNativeMaterial(rp, indices,
+        attributes.shade, attributes.position, attributes.uv, attributes.dx, attributes.dy,
+        seed, materialShade, combined, alphaCompare, coverage);
+    uint2 owner = NativeOwner.Load(int3(pixel, 0));
+    bool nativeCovered = owner.x == Params.renderIndex + 1 && owner.y == 0;
+    InterlockedAdd(Results[Params.resultIndex].tested, 1);
+    if (nativeCovered) InterlockedAdd(Results[Params.resultIndex].nativeCovered, 1);
+    if (evaluated) InterlockedAdd(Results[Params.resultIndex].evaluatedCovered, 1);
+    if (nativeCovered != evaluated || (owner.x != 0 && !nativeCovered)) {
+        InterlockedAdd(Results[Params.resultIndex].disagreements, 1);
+        uint previous;
+        InterlockedCompareExchange(Results[Params.resultIndex].firstMismatchPixel,
+            0xFFFFFFFF, uint(pixel.y) * Params.targetSize.x + uint(pixel.x), previous);
+        if (previous == 0xFFFFFFFF) {
+            Results[Params.resultIndex].sampleUVPosition = float4(attributes.uv, attributes.position.xy);
+            Results[Params.resultIndex].sampleDxDy = float4(attributes.dx, attributes.dy);
+            Results[Params.resultIndex].sampleAlphaDepthShade = float4(combined.a, alphaCompare,
+                attributes.position.z, attributes.shade.a);
+            Results[Params.resultIndex].nativeUVShadeAlpha = NativeUV.Load(int3(pixel, 0));
+            Results[Params.resultIndex].nativeDxDy = NativeDerivatives.Load(int3(pixel, 0));
+        }
+    }
+}
