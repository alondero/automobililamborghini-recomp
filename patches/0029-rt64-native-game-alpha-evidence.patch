diff --git a/src/render/rt64_native_alpha_evidence.cpp b/src/render/rt64_native_alpha_evidence.cpp
new file mode 100644
index 0000000..9a2e1eb
--- /dev/null
+++ b/src/render/rt64_native_alpha_evidence.cpp
@@ -0,0 +1,333 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 RT64 Contributors
+#include "rt64_native_alpha_evidence.h"
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <stdexcept>
+#include "hle/rt64_workload.h"
+#include "rt64_framebuffer_renderer.h"
+#include "shared/rt64_raster_params.h"
+#ifdef _WIN32
+#include "contrib/plume/plume_d3d12.h"
+#include "shaders/NativeAlphaEvidenceCS.hlsl.dxil.h"
+#include "shaders/NativeAlphaInputPS.hlsl.dxil.h"
+#include "shaders/NativeAlphaVerticesGS.hlsl.dxil.h"
+#endif
+
+namespace RT64 {
+bool CheckNativeAlphaEvidence(RenderWorker *worker, const FramebufferRenderer &renderer,
+        uint32_t framebufferIndex, const Workload &workload,
+        const std::vector<std::array<float, 4>> &screen, const std::vector<uint32_t> &renderIndices,
+        std::vector<interop::NativeAlphaEvidenceResult> &results,
+        std::vector<NativeAlphaVertexShaderEvidence> &vertexShaders,
+        std::vector<std::array<float, 4>> &nativeClip, std::string &error) {
+    results.clear();
+    vertexShaders.clear();
+    nativeClip.clear();
+    error.clear();
+#ifndef _WIN32
+    error = "Native alpha evidence requires the D3D12 diagnostic backend";
+    return false;
+#else
+    try {
+        const auto require = [](bool value, const char *message) {
+            if (!value) throw std::runtime_error(message);
+        };
+        require(worker && worker->device && framebufferIndex < renderer.framebufferCount &&
+            framebufferIndex < renderer.framebufferVector.size(), "Invalid native alpha evidence binding");
+        require(dynamic_cast<plume::D3D12Device *>(worker->device) != nullptr,
+            "Native alpha evidence requires the D3D12 diagnostic backend");
+        require(worker->device->getCapabilities().geometryShader, "Native alpha vertex tracing unsupported");
+        const auto &fb = renderer.framebufferVector[framebufferIndex];
+        const auto *storage = fb.renderTargetDrawCall.fbStorage;
+        require(storage && storage->colorTarget && storage->depthTarget, "Native alpha framebuffer unavailable");
+        require(storage->colorTarget->multisampling.sampleCount <= 1 &&
+            storage->depthTarget->multisampling.sampleCount <= 1, "MSAA alpha evidence unsupported");
+        const uint32_t width = storage->colorTarget->width, height = storage->colorTarget->height;
+        require(width && height && width <= 4096 && height <= 4096, "Native alpha target exceeds budget");
+        // Owner, depth and two float4 attribute targets, plus bounded buffers.
+        require(uint64_t(width) * height <= (120u * 1024u * 1024u) / 44,
+            "Native alpha target memory budget exceeded");
+        require(screen.size() == workload.drawData.vertexCount() &&
+            renderer.descCommonSet && renderer.descTextureSet && fb.descDummyFbSet &&
+            renderer.rendererPipelineLayout, "Native alpha material bindings unavailable");
+        std::vector<interop::NativeAlphaEvidenceParams> params;
+        size_t shaderBytes = 0;
+        for (uint32_t renderIndex : renderIndices) {
+            require(renderIndex < renderer.instanceDrawCallVector.size() &&
+                renderIndex < renderer.renderIndicesVector.size(), "Native alpha render index out of range");
+            const auto &call = renderer.instanceDrawCallVector[renderIndex];
+            require(call.type == InstanceDrawCall::Type::IndexedTriangles &&
+                !call.triangles.vertexTestZ && call.triangles.ownerPipeline && call.triangles.evidenceVertexShader &&
+                call.triangles.shaderDesc.flags.sampleCount == 0, "Unsupported native alpha raster draw");
+            const auto *nativeVS = dynamic_cast<const plume::D3D12Shader *>(call.triangles.evidenceVertexShader);
+            require(nativeVS && !nativeVS->d3d.empty() &&
+                nativeVS->d3d.size() <= 16u * 1024u * 1024u - shaderBytes,
+                "Native alpha vertex shader evidence exceeds budget");
+            shaderBytes += nativeVS->d3d.size();
+            vertexShaders.push_back({renderIndex, nativeVS->d3d});
+            require(call.triangles.faceCount <= 16384 - params.size(), "Native alpha face budget exceeded");
+            const auto &indices = workload.drawData.faceIndices;
+            const uint32_t start = call.triangles.indexStart, count = call.triangles.faceCount * 3;
+            require(start <= indices.size() && count <= indices.size() - start, "Native alpha face extent mismatch");
+            for (uint32_t face = start; face < start + count; face += 3) {
+                interop::NativeAlphaEvidenceParams p{};
+                p.renderIndex = renderIndex;
+                p.faceStart = face;
+                p.resultIndex = uint32_t(params.size());
+                p.screenScale = call.triangles.screenScale;
+                p.screenOffset = call.triangles.screenOffset;
+                p.viewport = {fb.viewport.x, fb.viewport.y, fb.viewport.width, fb.viewport.height};
+                p.targetSize = {width, height};
+                double left = width, top = height, right = 0, bottom = 0;
+                bool finite = true;
+                for (uint32_t i = 0; i < 3; ++i) {
+                    require(indices[face + i] < screen.size(), "Native alpha vertex out of range");
+                    const auto &s = screen[indices[face + i]];
+                    finite &= std::isfinite(s[0]) && std::isfinite(s[1]) &&
+                        std::isfinite(s[2]) && std::isfinite(s[3]) && s[3] > 1e-6f;
+                    const double ndcX = (s[0] - fb.evidenceParams.resolution.x / 2) /
+                        (fb.evidenceParams.resolution.x / 2);
+                    const double ndcY = (s[1] - fb.evidenceParams.resolution.y / 2) /
+                        (-fb.evidenceParams.resolution.y / 2);
+                    const double x = fb.viewport.x + fb.viewport.width / 2 +
+                        (ndcX * p.screenScale.x + p.screenOffset.x) * fb.viewport.width / 2;
+                    const double y = fb.viewport.y + fb.viewport.height / 2 -
+                        (ndcY * p.screenScale.y + p.screenOffset.y) * fb.viewport.height / 2;
+                    finite &= std::isfinite(x) && std::isfinite(y);
+                    left = std::min(left, x); right = std::max(right, x);
+                    top = std::min(top, y); bottom = std::max(bottom, y);
+                }
+                const auto &scissor = call.triangles.scissor;
+                const int32_t maxX = std::min<int32_t>(int32_t(width), scissor.right);
+                const int32_t maxY = std::min<int32_t>(int32_t(height), scissor.bottom);
+                const int32_t minX = std::max(0, scissor.left), minY = std::max(0, scissor.top);
+                require(maxX >= minX && maxY >= minY, "Invalid native alpha scissor");
+                // Expand the CPU bounds before dispatch: the GPU computes the
+                // final barycentrics from the exact generated attributes.
+                p.testRect = finite ? interop::int4(
+                    int32_t(std::clamp(std::floor(left) - 2, double(minX), double(maxX))),
+                    int32_t(std::clamp(std::floor(top) - 2, double(minY), double(maxY))),
+                    int32_t(std::clamp(std::ceil(right) + 2, double(minX), double(maxX))),
+                    int32_t(std::clamp(std::ceil(bottom) + 2, double(minY), double(maxY)))) :
+                    interop::int4(minX, minY, std::min(minX + 1, maxX), std::min(minY + 1, maxY));
+                params.push_back(p);
+                results.push_back({renderIndex, face, 0, 0, 0, 0, 0, 0xFFFFFFFF, {}, {}, {}, {}, {}});
+            }
+        }
+        require(!params.empty(), "No native alpha faces selected");
+        const size_t bytes = results.size() * sizeof(results[0]);
+        nativeClip.resize(results.size() * 3);
+        const size_t clipBytes = nativeClip.size() * sizeof(nativeClip[0]);
+        auto *device = worker->device;
+        auto initial = device->createBuffer(RenderBufferDesc::UploadBuffer(bytes));
+        auto output = device->createBuffer(RenderBufferDesc::DefaultBuffer(bytes,
+            RenderBufferFlag::STORAGE | RenderBufferFlag::UNORDERED_ACCESS));
+        auto readback = device->createBuffer(RenderBufferDesc::ReadbackBuffer(bytes));
+        auto initialClip = device->createBuffer(RenderBufferDesc::UploadBuffer(clipBytes));
+        auto clip = device->createBuffer(RenderBufferDesc::DefaultBuffer(clipBytes,
+            RenderBufferFlag::STORAGE | RenderBufferFlag::UNORDERED_ACCESS));
+        auto clipReadback = device->createBuffer(RenderBufferDesc::ReadbackBuffer(clipBytes));
+        auto reference = device->createTexture(RenderTextureDesc::ColorTarget(width, height, RenderFormat::R32G32_UINT));
+        auto depth = device->createTexture(RenderTextureDesc::DepthTarget(width, height, RenderFormat::D32_FLOAT));
+        auto nativeUV = device->createTexture(RenderTextureDesc::ColorTarget(width, height, RenderFormat::R32G32B32A32_FLOAT));
+        auto nativeDerivatives = device->createTexture(RenderTextureDesc::ColorTarget(width, height, RenderFormat::R32G32B32A32_FLOAT));
+        require(initial && output && readback && initialClip && clip && clipReadback && reference && depth && nativeUV && nativeDerivatives,
+            "Native alpha resources unavailable");
+        const RenderTexture *attachment = reference.get();
+        auto framebuffer = device->createFramebuffer(RenderFramebufferDesc(&attachment, 1, depth.get()));
+        const RenderTexture *inputAttachments[] = {nativeUV.get(), nativeDerivatives.get()};
+        auto inputFramebuffer = device->createFramebuffer(RenderFramebufferDesc(inputAttachments, 2, depth.get()));
+        auto inputShader = device->createShader(NativeAlphaInputPSBlobDXIL, sizeof(NativeAlphaInputPSBlobDXIL),
+            "PSMain", RenderShaderFormat::DXIL);
+        auto geometryShader = device->createShader(NativeAlphaVerticesGSBlobDXIL, sizeof(NativeAlphaVerticesGSBlobDXIL),
+            "GSMain", RenderShaderFormat::DXIL);
+        require(inputFramebuffer && inputShader && geometryShader, "Native alpha input pipeline bindings unavailable");
+        const RenderInputElement elements[] = {
+            RenderInputElement("POSITION", 0, 0, RenderFormat::R32G32B32A32_FLOAT, 0, 0),
+            RenderInputElement("TEXCOORD", 0, 1, RenderFormat::R32G32_FLOAT, 1, 0),
+            RenderInputElement("COLOR", 0, 2, RenderFormat::R32G32B32A32_FLOAT, 2, 0)
+        };
+        RenderDescriptorSetBuilder builder;
+        builder.begin();
+        const auto facesBinding = builder.addByteAddressBuffer(0), screenBinding = builder.addByteAddressBuffer(1);
+        const auto uvBinding = builder.addByteAddressBuffer(2), shadeBinding = builder.addByteAddressBuffer(3);
+        const auto referenceBinding = builder.addTexture(4), resultBinding = builder.addReadWriteStructuredBuffer(0);
+        const auto nativeUVBinding = builder.addTexture(5), nativeDerivativesBinding = builder.addTexture(6);
+        const auto clipBinding = builder.addReadWriteStructuredBuffer(1), clipReadBinding = builder.addStructuredBuffer(7);
+        builder.end();
+        auto set = builder.create(device);
+        RenderPipelineLayoutBuilder layoutBuilder;
+        layoutBuilder.begin(false, true);
+        layoutBuilder.addDescriptorSet(*renderer.descCommonSet);
+        layoutBuilder.addDescriptorSet(*renderer.descTextureSet);
+        layoutBuilder.addDescriptorSet(*renderer.descTextureSet);
+        layoutBuilder.addDescriptorSet(*fb.descDummyFbSet);
+        layoutBuilder.addDescriptorSet(builder.descriptorSetDesc);
+        layoutBuilder.addPushConstant(0, 0, sizeof(interop::RasterParams), RenderShaderStageFlag::VERTEX | RenderShaderStageFlag::PIXEL);
+        layoutBuilder.addPushConstant(0, 4, sizeof(interop::NativeAlphaEvidenceParams), RenderShaderStageFlag::GEOMETRY | RenderShaderStageFlag::COMPUTE);
+        layoutBuilder.end();
+        auto layout = layoutBuilder.create(device);
+        auto shader = device->createShader(NativeAlphaEvidenceCSBlobDXIL, sizeof(NativeAlphaEvidenceCSBlobDXIL),
+            "CSMain", RenderShaderFormat::DXIL);
+        require(framebuffer && set && layout && shader, "Native alpha pipeline bindings unavailable");
+        auto pipeline = device->createComputePipeline(RenderComputePipelineDesc(layout.get(), shader.get(), 8, 8, 1));
+        require(bool(pipeline), "Native alpha pipeline creation failed");
+        std::vector<std::unique_ptr<RenderPipeline>> inputPipelines;
+        for (uint32_t renderIndex : renderIndices) {
+            const auto &call = renderer.instanceDrawCallVector[renderIndex];
+            RenderGraphicsPipelineDesc desc;
+            desc.pipelineLayout = layout.get();
+            desc.vertexShader = call.triangles.evidenceVertexShader;
+            desc.geometryShader = geometryShader.get();
+            desc.pixelShader = inputShader.get();
+            desc.renderTargetCount = 2;
+            for (uint32_t i = 0; i < 2; ++i) {
+                desc.renderTargetFormat[i] = RenderFormat::R32G32B32A32_FLOAT;
+                desc.renderTargetBlend[i] = RenderBlendDesc::Copy();
+            }
+            desc.depthTargetFormat = RenderFormat::D32_FLOAT;
+            desc.depthClipEnabled = !call.triangles.shaderDesc.flags.NoN;
+            desc.depthEnabled = desc.depthWriteEnabled = true;
+            desc.depthFunction = RenderComparisonFunction::LESS;
+            desc.inputSlots = renderer.vertexInputSlots.data();
+            desc.inputSlotsCount = uint32_t(renderer.vertexInputSlots.size());
+            desc.inputElements = elements;
+            desc.inputElementsCount = 3;
+            auto nativePipeline = device->createGraphicsPipeline(desc);
+            require(bool(nativePipeline), "Native alpha input pipeline creation failed");
+            inputPipelines.push_back(std::move(nativePipeline));
+        }
+        void *mapped = initial->map();
+        require(mapped != nullptr, "Native alpha initialization map failed");
+        std::memcpy(mapped, results.data(), bytes);
+        initial->unmap();
+        mapped = initialClip->map();
+        require(mapped != nullptr, "Native alpha clip initialization map failed");
+        std::memset(mapped, 0, clipBytes);
+        initialClip->unmap();
+        set->setBuffer(facesBinding, workload.drawBuffers.faceIndicesBuffer.get(), workload.drawBuffers.faceIndicesBuffer.allocatedSize);
+        set->setBuffer(screenBinding, workload.outputBuffers.screenPosBuffer.buffer.get(), workload.outputBuffers.screenPosBuffer.allocatedSize);
+        set->setBuffer(uvBinding, workload.outputBuffers.genTexCoordBuffer.buffer.get(), workload.outputBuffers.genTexCoordBuffer.allocatedSize);
+        set->setBuffer(shadeBinding, workload.outputBuffers.shadedColBuffer.buffer.get(), workload.outputBuffers.shadedColBuffer.allocatedSize);
+        set->setTexture(referenceBinding, reference.get(), RenderTextureLayout::SHADER_READ);
+        set->setTexture(nativeUVBinding, nativeUV.get(), RenderTextureLayout::SHADER_READ);
+        set->setTexture(nativeDerivativesBinding, nativeDerivatives.get(), RenderTextureLayout::SHADER_READ);
+        const RenderBufferStructuredView resultView(sizeof(interop::NativeAlphaEvidenceResult));
+        set->setBuffer(resultBinding, output.get(), bytes, &resultView);
+        const RenderBufferStructuredView clipView(sizeof(nativeClip[0]));
+        set->setBuffer(clipBinding, clip.get(), clipBytes, &clipView);
+        set->setBuffer(clipReadBinding, clip.get(), clipBytes, &clipView);
+        auto *commands = worker->commandList.get();
+        // Declared after the GPU resources so unwinding fences submitted work
+        // before destroying any allocation or borrowed-resource descriptor.
+        struct FenceScope {
+            RenderWorker *worker;
+            bool recording = false, submitted = false;
+            ~FenceScope() {
+                if (recording) worker->commandList->end();
+                if (submitted) worker->wait();
+            }
+        } fence{worker};
+        commands->begin(); fence.recording = true;
+        commands->barriers(RenderBarrierStage::COPY, RenderBufferBarrier(output.get(), RenderBufferAccess::WRITE));
+        commands->copyBufferRegion(output->at(0), initial->at(0), bytes);
+        commands->barriers(RenderBarrierStage::COPY, RenderBufferBarrier(clip.get(), RenderBufferAccess::WRITE));
+        commands->copyBufferRegion(clip->at(0), initialClip->at(0), clipBytes);
+        commands->barriers(RenderBarrierStage::GRAPHICS_AND_COMPUTE, {
+            RenderBufferBarrier(output.get(), RenderBufferAccess::WRITE),
+            RenderBufferBarrier(workload.drawBuffers.faceIndicesBuffer.defaultBuffer.get(), RenderBufferAccess::READ),
+            RenderBufferBarrier(workload.outputBuffers.screenPosBuffer.buffer.get(), RenderBufferAccess::READ),
+            RenderBufferBarrier(workload.outputBuffers.genTexCoordBuffer.buffer.get(), RenderBufferAccess::READ),
+            RenderBufferBarrier(workload.outputBuffers.shadedColBuffer.buffer.get(), RenderBufferAccess::READ)
+        });
+        for (const auto &p : params) {
+            if (p.testRect.z <= p.testRect.x || p.testRect.w <= p.testRect.y) continue;
+            const RenderRect rect(p.testRect.x, p.testRect.y, p.testRect.z, p.testRect.w);
+            const auto &call = renderer.instanceDrawCallVector[p.renderIndex];
+            commands->barriers(RenderBarrierStage::GRAPHICS, {
+                RenderTextureBarrier(reference.get(), RenderTextureLayout::COLOR_WRITE),
+                RenderTextureBarrier(depth.get(), RenderTextureLayout::DEPTH_WRITE)
+            });
+            commands->setFramebuffer(framebuffer.get());
+            commands->clearColor(0, RenderColor(0, 0, 0, 0), &rect, 1);
+            commands->clearDepth(true, 1, &rect, 1);
+            commands->setGraphicsPipelineLayout(renderer.rendererPipelineLayout);
+            commands->setGraphicsDescriptorSet(renderer.descCommonSet->get(), 0);
+            commands->setGraphicsDescriptorSet(renderer.descTextureSet->get(), 1);
+            commands->setGraphicsDescriptorSet(renderer.descTextureSet->get(), 2);
+            commands->setGraphicsDescriptorSet(fb.descDummyFbSet->get(), 3);
+            commands->setVertexBuffers(0, renderer.indexedVertexViews.data(), uint32_t(renderer.indexedVertexViews.size()), renderer.vertexInputSlots.data());
+            commands->setIndexBuffer(&renderer.indexBufferView);
+            commands->setViewports(fb.viewport);
+            commands->setScissors(rect);
+            commands->setPipeline(call.triangles.ownerPipeline);
+            interop::RasterParams raster{};
+            raster.renderIndex = p.renderIndex; raster.screenScale = p.screenScale; raster.screenOffset = p.screenOffset;
+            commands->setGraphicsPushConstants(0, &raster);
+            commands->drawIndexedInstanced(3, 1, p.faceStart, 0, 0);
+            commands->barriers(RenderBarrierStage::GRAPHICS, {
+                RenderTextureBarrier(nativeUV.get(), RenderTextureLayout::COLOR_WRITE),
+                RenderTextureBarrier(nativeDerivatives.get(), RenderTextureLayout::COLOR_WRITE)
+            });
+            commands->barriers(RenderBarrierStage::GRAPHICS, RenderBufferBarrier(clip.get(), RenderBufferAccess::WRITE));
+            commands->setFramebuffer(inputFramebuffer.get());
+            commands->clearColor(0, RenderColor(0, 0, 0, 0), &rect, 1);
+            commands->clearColor(1, RenderColor(0, 0, 0, 0), &rect, 1);
+            commands->clearDepth(true, 1, &rect, 1);
+            const auto draw = std::find(renderIndices.begin(), renderIndices.end(), p.renderIndex);
+            commands->setGraphicsPipelineLayout(layout.get());
+            commands->setGraphicsDescriptorSet(renderer.descCommonSet->get(), 0);
+            commands->setGraphicsDescriptorSet(renderer.descTextureSet->get(), 1);
+            commands->setGraphicsDescriptorSet(renderer.descTextureSet->get(), 2);
+            commands->setGraphicsDescriptorSet(fb.descDummyFbSet->get(), 3);
+            commands->setGraphicsDescriptorSet(set.get(), 4);
+            commands->setPipeline(inputPipelines[size_t(draw - renderIndices.begin())].get());
+            commands->setGraphicsPushConstants(0, &raster);
+            commands->setGraphicsPushConstants(1, &p);
+            commands->drawIndexedInstanced(3, 1, p.faceStart, 0, 0);
+            commands->barriers(RenderBarrierStage::COMPUTE, {
+                RenderTextureBarrier(reference.get(), RenderTextureLayout::SHADER_READ),
+                RenderTextureBarrier(nativeUV.get(), RenderTextureLayout::SHADER_READ),
+                RenderTextureBarrier(nativeDerivatives.get(), RenderTextureLayout::SHADER_READ)
+            });
+            commands->barriers(RenderBarrierStage::COMPUTE, RenderBufferBarrier(clip.get(), RenderBufferAccess::READ));
+            commands->setComputePipelineLayout(layout.get());
+            commands->setPipeline(pipeline.get());
+            commands->setComputeDescriptorSet(renderer.descCommonSet->get(), 0);
+            commands->setComputeDescriptorSet(renderer.descTextureSet->get(), 1);
+            commands->setComputeDescriptorSet(renderer.descTextureSet->get(), 2);
+            commands->setComputeDescriptorSet(fb.descDummyFbSet->get(), 3);
+            commands->setComputeDescriptorSet(set.get(), 4);
+            commands->setComputePushConstants(1, &p);
+            commands->dispatch((p.testRect.z - p.testRect.x + 7) / 8, (p.testRect.w - p.testRect.y + 7) / 8, 1);
+        }
+        commands->barriers(RenderBarrierStage::COPY, RenderBufferBarrier(output.get(), RenderBufferAccess::READ));
+        commands->copyBufferRegion(readback->at(0), output->at(0), bytes);
+        commands->barriers(RenderBarrierStage::COPY, RenderBufferBarrier(clip.get(), RenderBufferAccess::READ));
+        commands->copyBufferRegion(clipReadback->at(0), clip->at(0), clipBytes);
+        commands->end(); fence.recording = false;
+        worker->execute(); fence.submitted = true;
+        worker->wait(); fence.submitted = false;
+        RenderRange range(0, bytes);
+        const void *data = readback->map(0, &range);
+        require(data != nullptr, "Native alpha results map failed");
+        std::memcpy(results.data(), data, bytes);
+        readback->unmap(0, &range);
+        range = RenderRange(0, clipBytes);
+        data = clipReadback->map(0, &range);
+        require(data != nullptr, "Native alpha clip results map failed");
+        std::memcpy(nativeClip.data(), data, clipBytes);
+        clipReadback->unmap(0, &range);
+        return true;
+    } catch (const std::exception &e) {
+        error = e.what();
+        results.clear();
+        vertexShaders.clear();
+        nativeClip.clear();
+        return false;
+    }
+#endif
+}
+}
