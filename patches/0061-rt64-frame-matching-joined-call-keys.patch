new file mode 100644
index 0000000..1d24786
--- /dev/null
+++ b/src/hle/rt64_game_call_keys.h
@@ -0,0 +1,182 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+namespace RT64 {
+    // Frame matching pairs each draw call with every previous call of equal hash.
+    // Repeated scenery shares a hash, so most of those call pairs add the same
+    // check pairs. Each key holds only what decides the check pairs a call adds;
+    // joining sorted, unique keys adds the same set of check pairs without
+    // visiting every call pair.
+
+    struct CallTransformKey {
+        uint64_t callHash;
+        uint32_t worldMatrixCount;
+        uint32_t workloadIndex;
+        uint32_t minWorldMatrix;
+    };
+
+    struct CallTileKey {
+        uint64_t callHash;
+        uint32_t tileCount;
+        uint32_t tileSlot;
+        bool tileMatching;
+        uint64_t tmemHashOrID;
+        uint32_t tileIndex;
+    };
+
+    // The look at index is only read for calls that have a partner of equal hash,
+    // as the call-by-call pairing did: rectangle calls have no face indices.
+    struct CallLookAtKey {
+        uint64_t callHash;
+        uint32_t workloadIndex;
+        uint32_t faceIndicesStart;
+    };
+
+    inline auto callKeyTuple(const CallTransformKey &key) {
+        return std::tie(key.callHash, key.worldMatrixCount, key.workloadIndex, key.minWorldMatrix);
+    }
+
+    inline auto callKeyTuple(const CallTileKey &key) {
+        return std::tie(key.callHash, key.tileCount, key.tileSlot, key.tileMatching, key.tmemHashOrID, key.tileIndex);
+    }
+
+    inline auto callKeyTuple(const CallLookAtKey &key) {
+        return std::tie(key.callHash, key.workloadIndex, key.faceIndicesStart);
+    }
+
+    struct GameCallKeys {
+        std::vector<CallTransformKey> transforms;
+        std::vector<CallTileKey> tiles;
+        std::vector<CallLookAtKey> lookAts;
+
+        void clear() {
+            transforms.clear();
+            tiles.clear();
+            lookAts.clear();
+        }
+
+        void sortUnique() {
+            sortUniqueKeys(transforms);
+            sortUniqueKeys(tiles);
+            sortUniqueKeys(lookAts);
+        }
+
+    private:
+        template <typename Key>
+        static void sortUniqueKeys(std::vector<Key> &keys) {
+            std::sort(keys.begin(), keys.end(), [](const Key &lhs, const Key &rhs) { return callKeyTuple(lhs) < callKeyTuple(rhs); });
+            keys.erase(std::unique(keys.begin(), keys.end(), [](const Key &lhs, const Key &rhs) { return callKeyTuple(lhs) == callKeyTuple(rhs); }), keys.end());
+        }
+    };
+
+    // Calls pairRuns(curFirst, curLast, prevFirst, prevLast) for each run of keys
+    // that are equal under less and present in both sorted ranges.
+    template <typename Iterator, typename Less, typename PairRuns>
+    void joinCallKeyRuns(Iterator curIt, Iterator curEnd, Iterator prevIt, Iterator prevEnd, Less less, PairRuns pairRuns) {
+        while ((curIt != curEnd) && (prevIt != prevEnd)) {
+            if (less(*curIt, *prevIt)) {
+                curIt++;
+            }
+            else if (less(*prevIt, *curIt)) {
+                prevIt++;
+            }
+            else {
+                const Iterator curRunEnd = std::upper_bound(curIt, curEnd, *curIt, less);
+                const Iterator prevRunEnd = std::upper_bound(prevIt, prevEnd, *curIt, less);
+                pairRuns(curIt, curRunEnd, prevIt, prevRunEnd);
+                curIt = curRunEnd;
+                prevIt = prevRunEnd;
+            }
+        }
+    }
+
+    // Adds the check pairs of every pair of current and previous calls with equal
+    // hash, given keys made unique by GameCallKeys::sortUnique. A pair can be added
+    // more than once; the caller sorts the check pairs and removes duplicates.
+    // addTransformPairs(curKey, prevKey) adds the transform pairs of two calls with
+    // the same number of world matrices. lookAtIndex(key) reads a call's look at.
+    template <typename AddTransformPairs, typename LookAtIndex>
+    void pairCallKeys(const GameCallKeys &cur, const GameCallKeys &prev, AddTransformPairs addTransformPairs, LookAtIndex lookAtIndex,
+        std::vector<std::pair<uint32_t, uint32_t>> &tileCheckSet, std::vector<std::pair<uint32_t, uint32_t>> &lookAtCheckSet)
+    {
+        typedef std::vector<CallTransformKey>::const_iterator TransformIterator;
+        typedef std::vector<CallTileKey>::const_iterator TileIterator;
+        typedef std::vector<CallLookAtKey>::const_iterator LookAtIterator;
+        const auto transformRunLess = [](const CallTransformKey &lhs, const CallTransformKey &rhs) {
+            return std::tie(lhs.callHash, lhs.worldMatrixCount) < std::tie(rhs.callHash, rhs.worldMatrixCount);
+        };
+
+        joinCallKeyRuns(cur.transforms.begin(), cur.transforms.end(), prev.transforms.begin(), prev.transforms.end(), transformRunLess,
+            [&](TransformIterator curFirst, TransformIterator curLast, TransformIterator prevFirst, TransformIterator prevLast) {
+                for (TransformIterator curIt = curFirst; curIt != curLast; curIt++) {
+                    for (TransformIterator prevIt = prevFirst; prevIt != prevLast; prevIt++) {
+                        addTransformPairs(*curIt, *prevIt);
+                    }
+                }
+            });
+
+        // Tiles of both calls must hold the same TMEM contents only when both calls match tiles.
+        const auto tileRunLess = [](const CallTileKey &lhs, const CallTileKey &rhs) {
+            return std::tie(lhs.callHash, lhs.tileCount, lhs.tileSlot) < std::tie(rhs.callHash, rhs.tileCount, rhs.tileSlot);
+        };
+
+        const auto tmemLess = [](const CallTileKey &lhs, const CallTileKey &rhs) {
+            return lhs.tmemHashOrID < rhs.tmemHashOrID;
+        };
+
+        const auto addTilePairs = [&](TileIterator curFirst, TileIterator curLast, TileIterator prevFirst, TileIterator prevLast) {
+            for (TileIterator curIt = curFirst; curIt != curLast; curIt++) {
+                for (TileIterator prevIt = prevFirst; prevIt != prevLast; prevIt++) {
+                    tileCheckSet.emplace_back(curIt->tileIndex, prevIt->tileIndex);
+                }
+            }
+        };
+
+        joinCallKeyRuns(cur.tiles.begin(), cur.tiles.end(), prev.tiles.begin(), prev.tiles.end(), tileRunLess,
+            [&](TileIterator curFirst, TileIterator curLast, TileIterator prevFirst, TileIterator prevLast) {
+                // Keys that don't match tiles sort first in each run, then the rest by TMEM.
+                const auto notMatching = [](const CallTileKey &key) { return !key.tileMatching; };
+                const TileIterator curMatching = std::partition_point(curFirst, curLast, notMatching);
+                const TileIterator prevMatching = std::partition_point(prevFirst, prevLast, notMatching);
+                addTilePairs(curFirst, curMatching, prevFirst, prevLast);
+                addTilePairs(curMatching, curLast, prevFirst, prevMatching);
+                joinCallKeyRuns(curMatching, curLast, prevMatching, prevLast, tmemLess, addTilePairs);
+            });
+
+        thread_local std::vector<uint32_t> curLookAts;
+        thread_local std::vector<uint32_t> prevLookAts;
+        const auto lookAtRunLess = [](const CallLookAtKey &lhs, const CallLookAtKey &rhs) {
+            return lhs.callHash < rhs.callHash;
+        };
+
+        const auto uniqueLookAts = [&](LookAtIterator first, LookAtIterator last, std::vector<uint32_t> &lookAts) {
+            lookAts.clear();
+            for (LookAtIterator it = first; it != last; it++) {
+                lookAts.emplace_back(lookAtIndex(*it));
+            }
+
+            std::sort(lookAts.begin(), lookAts.end());
+            lookAts.erase(std::unique(lookAts.begin(), lookAts.end()), lookAts.end());
+        };
+
+        joinCallKeyRuns(cur.lookAts.begin(), cur.lookAts.end(), prev.lookAts.begin(), prev.lookAts.end(), lookAtRunLess,
+            [&](LookAtIterator curFirst, LookAtIterator curLast, LookAtIterator prevFirst, LookAtIterator prevLast) {
+                uniqueLookAts(curFirst, curLast, curLookAts);
+                uniqueLookAts(prevFirst, prevLast, prevLookAts);
+                for (uint32_t curLookAt : curLookAts) {
+                    for (uint32_t prevLookAt : prevLookAts) {
+                        lookAtCheckSet.emplace_back(curLookAt, prevLookAt);
+                    }
+                }
+            });
+    }
+};
