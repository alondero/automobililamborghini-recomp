+++ b/recompui/src/core/ui_document_source.h
@@ -0,0 +1,19 @@
+#pragma once
+
+#include <algorithm>
+#include <filesystem>
+#include <string>
+
+namespace recompui::detail {
+
+// RmlUi document sources use forward slashes and encode a Windows drive
+// colon as '|'. Its JoinPath restores the colon before opening a file.
+inline std::string document_source_url(const std::filesystem::path& path) {
+    const std::u8string utf8 = path.generic_u8string();
+    std::string source(reinterpret_cast<const char*>(utf8.c_str()), utf8.size());
+    std::replace(source.begin(), source.end(), '\\', '/');
+    if (source.size() > 1 && source[1] == ':') source[1] = '|';
+    return source;
+}
+
+} // namespace recompui::detail
