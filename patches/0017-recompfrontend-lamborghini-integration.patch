+void playerassignment::add_controller_player(SDL_GameController* controller) {
+    if (!controller || !SDL_GameControllerGetAttached(controller) ||
+        PlayerState.temp_players.get_count() >= players::get_max_number_of_players()) return;
+    for (const auto& player : PlayerState.temp_players) {
+        if (player.controller == controller) return;
+    }
+    PlayerState.temp_players.add_controller_player(controller);
+}
