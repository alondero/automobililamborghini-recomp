+    static bool pickSwapChainCompositeAlpha(VkCompositeAlphaFlagsKHR supported, VkCompositeAlphaFlagBitsKHR &picked) {
+        // Prefer opaque over inherit. The final pass does not promise an alpha of one, so a
+        // pre-multiplied or post-multiplied compositor could blend the game with the desktop.
+        if (supported & VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR) {
+            picked = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+            return true;
+        }
+        else if (supported & VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR) {
+            picked = VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR;
+            return true;
+        }
+
+        return false;
+    }
+
+    static uint32_t clampSwapChainImageCount(uint32_t requested, const VkSurfaceCapabilitiesKHR &capabilities) {
+        // A maximum of zero means the surface has no upper limit.
+        const uint32_t count = std::max(requested, capabilities.minImageCount);
+        return (capabilities.maxImageCount > 0) ? std::min(count, capabilities.maxImageCount) : count;
+    }
