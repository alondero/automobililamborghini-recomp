@@ -1034,6 +1034,34 @@
     return Android_RemoveHaptic(device_id);
 }
 
+/* Local extension: snapshots retain the native window while Vulkan owns its surface.
+   Callers release with ANativeWindow_release after retiring all GPU references. */
+Uint64 SDL_AndroidGetNativeWindowGeneration(void)
+{
+    Uint64 generation = 0;
+    SDL_LockMutex(Android_ActivityMutex);
+    if (Android_Window) {
+        generation = ((SDL_WindowData *)Android_Window->driverdata)->surface_generation;
+    }
+    SDL_UnlockMutex(Android_ActivityMutex);
+    return generation;
+}
+
+void *SDL_AndroidAcquireNativeWindow(Uint64 *generation)
+{
+    ANativeWindow *window = NULL;
+    SDL_LockMutex(Android_ActivityMutex);
+    *generation = 0;
+    if (Android_Window) {
+        SDL_WindowData *data = (SDL_WindowData *)Android_Window->driverdata;
+        *generation = data->surface_generation;
+        window = data->native_window;
+        if (window) ANativeWindow_acquire(window);
+    }
+    SDL_UnlockMutex(Android_ActivityMutex);
+    return window;
+}
+
 /* Called from surfaceCreated() */
