+// Declared here because sunlight can stop as soon as the sky term is zero.
+float SunShadowOpenSky(RaytracingAccelerationStructure scene, float3 origin, float3 normal,
+    float distance, uint worldMask);
+
 // All admitted triangles are non-opaque in the AS for exact face exclusion.
 // Metadata is {faceStart, draw, indexCount, nativeAlphaCoverage}. The optional
 // candidate evaluator must distinguish unsupported input from an alpha hole.
 // occluderMask selects the instances that block the light.
-float SunShadowVisibilityMasked(RaytracingAccelerationStructure scene,
-    StructuredBuffer<uint4> geometry, float3 position, float3 geometricNormal,
-    uint receiverDraw, uint receiverFaceStart, SunShadowParams p, uint occluderMask, out bool coverageValid)
+float SunShadowVisibilityWithSkyMasked(RaytracingAccelerationStructure scene,
+    StructuredBuffer<uint4> geometry, float3 position, float3 geometricNormal,
+    uint receiverDraw, uint receiverFaceStart, SunShadowParams p, uint occluderMask, out bool coverageValid,
+    float3 skyOrigin, float3 skyNormal, float skyDistance, uint skyMask, float skyOpenFull, out float skyLight)
 {
     coverageValid = true;
+    skyLight = 1.0f;
+    bool skyTested = false;
     if (!SunShadowValid(p) || !all(isfinite(position)) || !all(isfinite(geometricNormal)) ||
         dot(geometricNormal, geometricNormal) < 1e-12) return 1;
     uint count = p.angularRadius == 0 ? 1 : p.sampleCount;
@@ -78,9 +85,30 @@
             }
             query.CommitNonOpaqueTriangleHit();
         }
-        visibility += query.CommittedStatus() == COMMITTED_NOTHING ? 1 : 0;
+        const bool visible = query.CommittedStatus() == COMMITTED_NOTHING;
+        // Sky only matters when at least one sunlight sample is blocked. In a
+        // closed tunnel it cancels the entire sun term, so the remaining soft
+        // shadow samples cannot affect the pixel. Keep the original sample set.
+        if (!visible && skyDistance > 0 && !skyTested) {
+            const float sky = SunShadowOpenSky(scene, skyOrigin, skyNormal, skyDistance, skyMask);
+            skyLight = smoothstep(skyOpenFull * 0.25f, skyOpenFull, sky);
+            skyTested = true;
+            if (skyLight == 0.0f) return 0.0f;
+        }
+        visibility += visible ? 1 : 0;
     }
     return visibility / float(count);
+}
+
+// Callers without sky fading retain the original visibility and coverage contract.
+float SunShadowVisibilityMasked(RaytracingAccelerationStructure scene,
+    StructuredBuffer<uint4> geometry, float3 position, float3 geometricNormal,
+    uint receiverDraw, uint receiverFaceStart, SunShadowParams p, uint occluderMask, out bool coverageValid)
+{
+    float skyLight;
+    return SunShadowVisibilityWithSkyMasked(scene, geometry, position, geometricNormal,
+        receiverDraw, receiverFaceStart, p, occluderMask, coverageValid,
+        0.0f, 0.0f, 0.0f, 0, 0.5f, skyLight);
 }
 
