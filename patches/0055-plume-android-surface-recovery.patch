+    RenderSwapChain::DrainResult VulkanSwapChain::drain() {
+        // Queue idle is the legacy WSI teardown fallback, not a formal present fence.
+        // Rendering is complete here; presentation-engine retirement needs maintenance1.
+        const std::scoped_lock queueLock(*commandQueue->queue->mutex);
+        VkResult res = vkQueueWaitIdle(commandQueue->queue->vk);
+        if ((res != VK_SUCCESS) && (res != lastDrainResult)) {
+            fprintf(stderr, "Vulkan presentation drain failed: 0x%X.\n", res);
+        }
+        lastDrainResult = res; // Success permits the same later error to be reported again.
+        if (res != VK_SUCCESS) {
+            return (res == VK_ERROR_DEVICE_LOST) ? DrainResult::DeviceLost : DrainResult::Failed;
+        }
+        return DrainResult::Complete;
+    }
+
+#if defined(__ANDROID__) && defined(PLUME_SDL_VULKAN_ENABLED)
+    bool VulkanSwapChain::androidSurfaceCurrent() const {
+        return (surface != VK_NULL_HANDLE) && !surfaceLost &&
+            (SDL_AndroidGetNativeWindowGeneration() == surfaceGeneration);
+    }
+
+    void VulkanSwapChain::releaseSurface() {
+        // The caller drained submitted work and retired external framebuffers first.
+        releaseImageViews();
+        textures.clear();
+        releaseSwapChain();
+        if (surface != VK_NULL_HANDLE) {
+            vkDestroySurfaceKHR(commandQueue->device->renderInterface->instance, surface, nullptr);
+            surface = VK_NULL_HANDLE;
+        }
+        if (nativeWindow != nullptr) {
+            ANativeWindow_release(static_cast<ANativeWindow *>(nativeWindow));
+            nativeWindow = nullptr;
+        }
+        pickedSurfaceFormat = {};
+        surfacePresentable = false;
+        currentPresentId = 0;
+    }
+
+    const char *VulkanSwapChain::recoverSurface(uint32_t &detail) {
+        Uint64 generation = 0;
+        auto *window = static_cast<ANativeWindow *>(SDL_AndroidAcquireNativeWindow(&generation));
+        if (window && androidSurfaceCurrent() && (generation == surfaceGeneration)) {
+            ANativeWindow_release(window);
+            return nullptr;
+        }
+
+        releaseSurface();
+        surfaceGeneration = generation;
+        surfaceLost = false;
+        if (window == nullptr) return "the Android native window is unavailable";
+
+        nativeWindow = window;
+        VkAndroidSurfaceCreateInfoKHR info = {};
+        info.sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+        info.window = window;
+        VkResult res = vkCreateAndroidSurfaceKHR(commandQueue->device->renderInterface->instance, &info, nullptr, &surface);
+        if (res != VK_SUCCESS) {
+            detail = res;
+            releaseSurface();
+            return "vkCreateAndroidSurfaceKHR failed";
+        }
+        VkBool32 supported = VK_FALSE;
+        res = vkGetPhysicalDeviceSurfaceSupportKHR(commandQueue->device->physicalDevice,
+            commandQueue->familyIndex, surface, &supported);
+        if (res != VK_SUCCESS) {
+            detail = res;
+            releaseSurface();
+            return "vkGetPhysicalDeviceSurfaceSupportKHR failed";
+        }
+        surfacePresentable = supported;
+        if (!surfacePresentable) {
+            releaseSurface();
+            return "the Android surface cannot be presented to";
+        }
+        if (!androidSurfaceCurrent()) {
+            releaseSurface();
+            return "the Android surface changed during recovery";
+        }
+        fprintf(stderr, "Vulkan native surface generation %llu ready.\n", static_cast<unsigned long long>(generation));
+        return nullptr;
+    }
+#endif
