     VulkanSwapChain::~VulkanSwapChain() {
+        const DrainResult drained = drain();
+        if (drained == DrainResult::Failed) {
+            // OOM and other errors do not establish completion. Abandon native GPU
+            // objects and the retained window without allocating on this error path.
+            // Detach the texture handles so automatic member destruction cannot free them.
+            for (VulkanTexture &texture : textures) {
+                texture.imageView = VK_NULL_HANDLE;
+                texture.vk = VK_NULL_HANDLE;
+            }
+#if defined(__APPLE__)
+            windowWrapper.release();
+#endif
+            commandQueue->swapChains.erase(this);
+            return;
+        }
+        // Complete or device-lost teardown can release resources without aborting.
+#if defined(__ANDROID__) && defined(PLUME_SDL_VULKAN_ENABLED)
+        releaseSurface();
+#endif
         releaseImageViews();
         releaseSwapChain();
 
