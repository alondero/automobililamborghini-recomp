+                const std::scoped_lock lock(ext.sharedResources->configurationMutex);
+                swapChainWidth = ext.sharedResources->swapChainWidth;
+                swapChainHeight = ext.sharedResources->swapChainHeight;
+                swapChainRate = ext.sharedResources->swapChainRate;
+            }
+
+            // Frame times are the render thread's wall time per rendered frame,
+            // which includes waiting for that frame's GPU work to finish.
+            const uint32_t viWidth = viFbSize[0];
+            const uint32_t viHeight = viFbSize[1];
+            const double scaleX = float(workloadConfig.resolutionScale[0]);
+            const double scaleY = float(workloadConfig.resolutionScale[1]);
+            const uint32_t samples = ext.sharedResources->renderTargetManager.multisampling.sampleCount;
+            const double frames = std::max(renderCost.renderedFrames, 1U);
+            const double gpuSamples = std::max(renderCost.gpuSamples, 1U);
