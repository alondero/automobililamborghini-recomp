+    void WorkloadQueue::threadReportRenderCost(hlslpp::uint2 viFbSize, const WorkloadConfiguration &workloadConfig, uint32_t viOriginalRate) {
+        const double seconds = renderCost.timer.elapsedSeconds();
+        if (seconds < 5.0) {
+            return;
+        }
+
+        const uint64_t presented = ext.sharedResources->presentedFrames.load();
+        if (renderCostEnabled && (renderCost.workloads > 0)) {
+            uint32_t swapChainWidth, swapChainHeight, swapChainRate;
