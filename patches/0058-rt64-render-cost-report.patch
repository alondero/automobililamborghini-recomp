+                "game_fps=%.1f present_fps=%.1f frames=%u/%u frame_ms=%.1f/%.1f gpu_ms=%.1f/%.1f workload_ms=%.1f/%.1f setup_ms=%.1f match_ms=%.1f\n",
+                seconds, swapChainWidth, swapChainHeight, swapChainRate, viWidth, viHeight, viOriginalRate, workloadConfig.targetRate,
+                viWidth * scaleX, viHeight * scaleY, scaleX, scaleY, samples,
+                renderCost.workloads / seconds, (presented - renderCost.presentedAtStart) / seconds, renderCost.renderedFrames, renderCost.displayFrames,
+                renderCost.frameMs / frames, renderCost.frameMaxMs, renderCost.gpuMs / gpuSamples, renderCost.gpuMaxMs,
+                renderCost.workloadMs / renderCost.workloads, renderCost.workloadMaxMs,
+                renderCost.setupMs / renderCost.workloads, renderCost.matchMs / renderCost.workloads);
+            fflush(stdout);
+        }
+
+        renderCost = RenderCostWindow();
+        renderCost.presentedAtStart = presented;
+    }
