+        float4 orien = GE(h + float4(D.w, E.w, E.w, D.w), v + float4(E.y, E.y, H.y, H.y));
+        float4 hori  = LE(h, v) * clr;
+        float4 vert  = GE(h, v) * clr;
+
+        Output[coord] = (res + 2 * hori + 4 * vert + 8 * orien) / 15;
+    }
+}
