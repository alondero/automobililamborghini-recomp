+[numthreads(GROUP_SIZE, GROUP_SIZE, 1)]
+void CSMain(uint2 coord : SV_DispatchThreadID) {
+    if ((coord.x < gConstants.Resolution.x) && (coord.y < gConstants.Resolution.y)) {
+        /*	grid		corners		mids
+
+                  B		x   y	  	  x
+                D E F				w   y
+                  H		w   z	  	  z
