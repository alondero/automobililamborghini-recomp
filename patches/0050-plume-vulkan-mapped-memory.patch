+    [[noreturn]] static void failBufferMapping(const char *operation, VkResult result = VK_SUCCESS) {
+        fprintf(stderr, "Vulkan buffer mapping: %s", operation);
+        if (result != VK_SUCCESS) {
+            fprintf(stderr, " (VkResult=%d)", result);
+        }
+        fprintf(stderr, "; cannot continue.\n");
+        fflush(stderr);
+        abort();
+    }
+
     void *VulkanBuffer::map(uint32_t subresource, const RenderRange *readRange) {
+        // RenderRange is [begin, end) in bytes; it never offsets the returned pointer.
+        if ((subresource != 0) || (allocation == VK_NULL_HANDLE) ||
+            ((readRange != nullptr) && ((readRange->begin > readRange->end) || (readRange->end > desc.size)))) {
+            failBufferMapping("invalid read range, subresource or allocation");
+        }
+
         void *data = nullptr;
         VkResult res = vmaMapMemory(device->allocator, allocation, &data);
         if (res != VK_SUCCESS) {
-            fprintf(stderr, "vmaMapMemory failed with error code 0x%X.\n", res);
-            return nullptr;
+            // Callers generally dereference immediately, so a failed map must stop here.
+            failBufferMapping("vmaMapMemory failed", res);
+        }
+
+        // Omitted upload ranges are write-only. Readbacks default to the whole buffer;
+        // other heaps can request reads explicitly. The caller must wait for GPU writes.
+        const VkDeviceSize offset = (readRange != nullptr) ? readRange->begin : 0;
+        const VkDeviceSize size = (readRange != nullptr) ? readRange->end - readRange->begin :
+            ((desc.heapType == RenderHeapType::READBACK) ? desc.size : 0);
+        if (size > 0) {
+            res = vmaInvalidateAllocation(device->allocator, allocation, offset, size);
+            if (res != VK_SUCCESS) {
+                vmaUnmapMemory(device->allocator, allocation);
+                failBufferMapping("vmaInvalidateAllocation failed", res);
+            }
         }
 
+        mapCount++;
         return data;
     }
 
     void VulkanBuffer::unmap(uint32_t subresource, const RenderRange *writtenRange) {
+        if (mapCount == 0) {
+            failBufferMapping("unmap without a successful map");
+        }
+        if ((subresource != 0) ||
+            ((writtenRange != nullptr) && ((writtenRange->begin > writtenRange->end) || (writtenRange->end > desc.size)))) {
+            vmaUnmapMemory(device->allocator, allocation);
+            mapCount--;
+            failBufferMapping("invalid written range or subresource");
+        }
+
+        // Readbacks default to no writes. An explicit empty range means no writes
+        // on any heap. VMA handles atom alignment and skips coherent memory.
+        const VkDeviceSize offset = (writtenRange != nullptr) ? writtenRange->begin : 0;
+        const VkDeviceSize size = (writtenRange != nullptr) ? writtenRange->end - writtenRange->begin :
+            ((desc.heapType != RenderHeapType::READBACK) ? desc.size : 0);
+        VkResult res = VK_SUCCESS;
+        if (size > 0) {
+            res = vmaFlushAllocation(device->allocator, allocation, offset, size);
+        }
         vmaUnmapMemory(device->allocator, allocation);
+        mapCount--;
+        if (res != VK_SUCCESS) {
+            failBufferMapping("vmaFlushAllocation failed", res);
+        }
     }
 
