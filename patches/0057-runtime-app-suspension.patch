 // Start time for the program
-static std::chrono::high_resolution_clock::time_point start_time = std::chrono::high_resolution_clock::now();
+static const auto start_time = std::chrono::high_resolution_clock::now();
+// One clock owner for VI scheduling, osGetTime/osGetCount and guest timers.
+// Lifecycle publication never waits for guest or renderer threads.
+static std::mutex app_clock_mutex;
+static bool app_suspended = false;
+static std::chrono::high_resolution_clock::time_point suspended_since;
+static std::chrono::high_resolution_clock::duration suspended_duration{};
+
+void ultramodern::set_app_suspended(bool suspended) {
+    const std::scoped_lock lock(app_clock_mutex);
+    if (suspended == app_suspended) return;
+    const auto now = std::chrono::high_resolution_clock::now();
+    if (suspended) suspended_since = now;
+    else suspended_duration += now - suspended_since;
+    app_suspended = suspended;
+}
+
+bool ultramodern::is_app_suspended() {
+    const std::scoped_lock lock(app_clock_mutex);
+    return app_suspended;
+}
