diff --git a/src/rhi/rt64_render_hooks.h b/src/rhi/rt64_render_hooks.h
index d6b7b27..b34e438 100644
--- a/src/rhi/rt64_render_hooks.h
+++ b/src/rhi/rt64_render_hooks.h
@@ -84,6 +84,32 @@ namespace RT64 {
         RenderEvidenceObserver *previous;
     };
 
+    // Outcome of one Workload's optional sunlight replacement, reported after
+    // its GPU fence. `ready` means the native overlay was replaced by the ray
+    // traced receiver pass; every other path drew the native overlay.
+    struct SunShadowFrameResult {
+        uint64_t workloadId = 0, sceneEpoch = 0, taskSequence = 0;
+        bool requested = false, ready = false;
+        const char *reason = ""; // Static string naming the first failed gate.
+        uint32_t casterRanges = 0, receiverDraws = 0, overlaysReplaced = 0;
+        uint64_t triangles = 0, asBytes = 0, scratchBytes = 0;
+        // GPU time of the AS build and of the receiver pass plus composite.
+        double buildMicroseconds = 0, receiverMicroseconds = 0;
+    };
+
+    // Production seam for game-specific shadow admission. The provider owns
+    // policy and task identity; RT64 owns resources and the ready gate. Set it
+    // before queue threads start and clear it after they join. sunShadow runs
+    // on the queue thread before RSP processing; values are task-owned and the
+    // provider must not read guest RAM there.
+    struct SunShadowProvider {
+        virtual ~SunShadowProvider() = default;
+        virtual std::shared_ptr<const SunShadowWorkload> sunShadow(const Workload &workload) noexcept = 0;
+        virtual void sunShadowResult(const SunShadowFrameResult &result) noexcept { }
+    };
+    SunShadowProvider *GetSunShadowProvider();
+    void SetSunShadowProvider(SunShadowProvider *provider);
+
     RenderHookInit *GetRenderHookInit();
     RenderHookDraw *GetRenderHookDraw();
     RenderHookDeinit *GetRenderHookDeinit();
diff --git a/src/shaders/SunShadowCompositePS.hlsl b/src/shaders/SunShadowCompositePS.hlsl
new file mode 100644
index 0000000..03e109f
--- /dev/null
+++ b/src/shaders/SunShadowCompositePS.hlsl
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 RT64 Contributors
+//
+// Applies the receiver target once: C = T * C_native + (1 - T) * C_fog.
+// C_native is a copy of the color target taken just before this pass. The
+// result is clamped to C_native so a shadow can never brighten a pixel, even
+// where a translucent draw already covers the receiver. The pipeline writes
+// RGB only, keeping native coverage alpha for VI filtering; T = 1 writes the
+// native value back unchanged. The MSAA variant runs per sample.
+
+Texture2D<float4> gShadow : register(t0, space0);
+
+#if defined(MULTISAMPLING)
+Texture2DMS<float4> gNative : register(t1, space0);
+
+float4 PSMain(in float4 position : SV_POSITION, in uint sampleIndex : SV_SampleIndex) : SV_TARGET0 {
+    const float4 native = gNative.Load(int2(floor(position.xy)), sampleIndex);
+#else
+Texture2D<float4> gNative : register(t1, space0);
+
+float4 PSMain(in float4 position : SV_POSITION) : SV_TARGET0 {
+    const float4 native = gNative.Load(int3(floor(position.xy), 0));
+#endif
+    const float4 shadow = gShadow.Load(int3(floor(position.xy), 0));
+    const float3 shadowed = native.rgb * shadow.a + shadow.rgb * (1.0f - shadow.a);
+    return float4(min(native.rgb, shadowed), native.a);
+}
diff --git a/src/shaders/SunShadowCompositeVS.hlsl b/src/shaders/SunShadowCompositeVS.hlsl
