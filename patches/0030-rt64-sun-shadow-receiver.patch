@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 RT64 Contributors
+#pragma once
+
+#include "shared/rt64_hlsl.h"
+
+#ifdef HLSL_CPU
+namespace interop {
+#endif
+    // Per receiver draw: its native call identity and the first index of its
+    // original face range, matching SunShadowScene metadata for exact
+    // originating-face exclusion.
+    struct SunShadowReceiverParams {
+        uint draw;
+        uint faceStart;
+        uint2 padding;
+    };
+#ifdef HLSL_CPU
+};
