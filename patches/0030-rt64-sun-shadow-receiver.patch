diff --git a/src/shaders/SunShadowReceiverPS.hlsl b/src/shaders/SunShadowReceiverPS.hlsl
new file mode 100644
index 0000000..0681353
--- /dev/null
+++ b/src/shaders/SunShadowReceiverPS.hlsl
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 RT64 Contributors
+//
+// Shader Model 6.5 receiver pass for admitted opaque standard-fog surfaces.
+// It never changes native color directly: it writes the fog contribution and
+// shadow transmission to a private target that one composite applies once.
+
+#include "shared/rt64_other_mode.h"
+#include "shared/rt64_raster_params.h"
+#include "shared/rt64_render_flags.h"
+#include "shared/rt64_sun_shadow_receiver.h"
+
+#include "Depth.hlsli"
+#include "FbRendererCommon.hlsli"
+#include "SunShadow.hlsli"
+
+[[vk::push_constant]] ConstantBuffer<RasterParams> gConstants : register(b0, space0);
+ConstantBuffer<SunShadowReceiverParams> gReceiver : register(b0, space5);
+ConstantBuffer<SunShadowParams> gSunParams : register(b1, space5);
+#if defined(MULTISAMPLING)
+// RT64's multisample decal rule: compare with the pixel's averaged depth.
+Texture2DMS<float> gBackgroundDepth : register(t2, space3);
+
+float surfaceDepthAt(int2 pixel, uint sampleCount) {
+    float depth = 0.0f;
+    for (uint s = 0; s < sampleCount; s++) {
+        depth += gBackgroundDepth.Load(pixel, s);
+    }
+    return depth / float(sampleCount);
+}
+#else
+Texture2D<float> gBackgroundDepth : register(t2, space3);
+
+float surfaceDepthAt(int2 pixel, uint sampleCount) {
+    return gBackgroundDepth.Load(int3(pixel, 0));
+}
+#endif
+StructuredBuffer<float4> gShadowWorldPos : register(t0, space4);
+StructuredBuffer<uint> gShadowFaceIndices : register(t1, space4);
+RaytracingAccelerationStructure gShadowScene : register(t2, space4);
+StructuredBuffer<uint4> gShadowGeometry : register(t3, space4);
+
+float4 PSMain(
+    in float4 vertexPosition : SV_POSITION
+    , in float4 vertexShade : COLOR0
+    , in float3 vertexWorld : TEXCOORD1
+    , in uint primitiveIndex : SV_PrimitiveID
+    , in bool isFrontFace : SV_IsFrontFace
+) : SV_TARGET0
+{
+    const uint instanceIndex = instanceRenderIndices[gConstants.renderIndex].instanceIndex;
+    const RenderParams rp = DynamicRenderParams[instanceIndex];
+    const OtherMode otherMode = { rp.omL, rp.omH };
+    // Derivatives before any discard, as in RasterPS's decal path.
+    const float dz = (abs(ddx(vertexPosition.z)) + abs(ddy(vertexPosition.z))) * FbParams.resolutionScale.y;
+
+    // Native ubershader culling and F3D manual depth clipping (RasterPS).
+    if ((otherMode.cycleType() != G_CYC_COPY) && renderFlagCulling(rp.flags) && isFrontFace) discard;
+    const bool depthClampNear = renderFlagNoN(rp.flags);
+    const float MaxDepth = 1022.0f / 1024.0f;
+    if (depthClampNear) {
+        if (vertexPosition.z > MaxDepth) discard;
+    }
+    else if ((vertexPosition.z < 0.0f) || (vertexPosition.z > MaxDepth)) discard;
+
+    // Visible-surface test with RT64's decal coplanarity semantics: the
+    // receiver must be the surface that the native depth pass kept.
+    const float surfaceDepth = surfaceDepthAt(int2(floor(vertexPosition.xy)), 1U << renderFlagSampleCount(rp.flags));
+    const float tolerance = max(CoplanarDepthTolerance(surfaceDepth), dz);
+    const float pixelDepth = depthClampNear ? max(vertexPosition.z, 0.0f) : vertexPosition.z;
+    if (abs(pixelDepth - surfaceDepth) > tolerance) discard;
+
+    // Geometric normal of the presented triangle; bias only, no relighting.
+    const uint face = gReceiver.faceStart + 3 * primitiveIndex;
+    const float3 a = gShadowWorldPos[gShadowFaceIndices[face]].xyz;
+    const float3 b = gShadowWorldPos[gShadowFaceIndices[face + 1]].xyz;
+    const float3 c = gShadowWorldPos[gShadowFaceIndices[face + 2]].xyz;
+    bool coverageValid;
+    float visibility = SunShadowVisibility(gShadowScene, gShadowGeometry, vertexWorld,
+        cross(b - a, c - a), gReceiver.draw, face, gSunParams, coverageValid);
+    if (!coverageValid) visibility = 1.0f;
+    const float transmission = 1.0f - saturate(gSunParams.strength) * (1.0f - saturate(visibility));
+
+    // Standard fog: native = (1 - a) * surface + a * fog, a = shade alpha.
+    const float3 fogContribution = instanceRDPParams[instanceIndex].fogColor.rgb * saturate(vertexShade.a);
+    return float4(fogContribution, transmission);
+}
diff --git a/src/shaders/SunShadowReceiverVS.hlsl b/src/shaders/SunShadowReceiverVS.hlsl
new file mode 100644
index 0000000..66d9624
--- /dev/null
+++ b/src/shaders/SunShadowReceiverVS.hlsl
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 RT64 Contributors
+//
+// Re-rasterizes an admitted receiver with the ubershader's own RasterVS
+// position code, adding the presented world position of each vertex.
+
+#include "RasterVS.hlsl"
+
+StructuredBuffer<float4> gShadowWorldPos : register(t0, space4);
+
+void VSMain(
+    in float4 iPosition : POSITION
+    , in float2 iUV : TEXCOORD
+    , in float4 iColor : COLOR
+    , in uint vertexIndex : SV_VertexID
+    , out float4 oPosition : SV_POSITION
+    , out float4 oShade : COLOR0
+    , out float3 oWorld : TEXCOORD1
+)
+{
+    const uint instanceIndex = instanceRenderIndices[gConstants.renderIndex].instanceIndex;
+    float2 uv;
+    float4 smoothColor, flatColor;
+    RasterVS(DynamicRenderParams[instanceIndex], iPosition, iUV, iColor, oPosition, uv, smoothColor, flatColor);
+    oShade = iColor;
+    oWorld = gShadowWorldPos[vertexIndex].xyz;
+}
