# Native dependencies are fetched and pinned by scripts/build_android.py.
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_STATIC OFF CACHE BOOL "" FORCE)
set(SDL_TEST OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(ZSTD_BUILD_DICTBUILDER OFF CACHE BOOL "" FORCE)
set(ZSTD_BUILD_PROGRAMS OFF CACHE BOOL "" FORCE)
set(LAMBO_ANDROID_DEPS "${CMAKE_SOURCE_DIR}/build-android/deps" CACHE PATH "Android dependency sources")
add_subdirectory("${LAMBO_ANDROID_DEPS}/SDL" "${CMAKE_BINARY_DIR}/SDL")
set(SDL2_INCLUDE_DIRS "${LAMBO_ANDROID_DEPS}/SDL/include")
set(SDL2_LIBRARIES SDL2::SDL2)
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake/android")
foreach(dep ZLIB BZIP2 PNG HARFBUZZ BROTLI)
    set(FT_DISABLE_${dep} ON CACHE BOOL "" FORCE)
endforeach()
add_subdirectory("${LAMBO_ANDROID_DEPS}/freetype" "${CMAKE_BINARY_DIR}/freetype")
add_library(Freetype::Freetype ALIAS freetype)

# Shader binaries are generated by host executables, never Android executables.
if(CMAKE_HOST_WIN32)
    set(CMAKE_HOST_EXECUTABLE_SUFFIX ".exe")
endif()
if(NOT EXISTS "${LAMBO_HOST_TOOLS}/file_to_c${CMAKE_HOST_EXECUTABLE_SUFFIX}")
    message(FATAL_ERROR "Run scripts/build_android.py to build the host tools first")
endif()
add_executable(file_to_c IMPORTED GLOBAL)
set_target_properties(file_to_c PROPERTIES IMPORTED_LOCATION
    "${LAMBO_HOST_TOOLS}/file_to_c${CMAKE_HOST_EXECUTABLE_SUFFIX}")
set(LAMBO_DXC_ROOT "${CMAKE_SOURCE_DIR}/lib/rt64/src/contrib/dxc")
if(CMAKE_HOST_WIN32)
    set(LAMBO_HOST_DXC "${LAMBO_DXC_ROOT}/bin/x64/dxc.exe")
else()
    set(LAMBO_HOST_DXC ${CMAKE_COMMAND} -E env
        "LD_LIBRARY_PATH=${LAMBO_DXC_ROOT}/lib/x64"
        "${LAMBO_DXC_ROOT}/bin/x64/dxc-linux")
endif()
set(PLUME_SDL_VULKAN_ENABLED ON CACHE BOOL "" FORCE)
add_link_options("-Wl,-z,max-page-size=16384")
add_subdirectory("${LAMBO_ANDROID_DEPS}/adrenotools" "${CMAKE_BINARY_DIR}/adrenotools")
add_library(lambo_vulkan SHARED "${CMAKE_SOURCE_DIR}/src/android/lambo_vulkan_loader.cpp")
target_link_libraries(lambo_vulkan PRIVATE adrenotools log dl)
add_dependencies(lambo_vulkan main_hook hook_impl)
