body {
  margin: 0;
  width: 100%;
  height: 100%;
  font-family: Lato;
  color: #f5f7fb;
  background-color: rgba(10, 16, 28, 245);
}

#window {
  width: 100%;
  height: 100%;
  padding: 7%;
  box-sizing: border-box;
}

.panel {
  position: absolute;
  left: 7%;
  top: 7%;
  width: 86%;
  height: 86%;
  margin: 0;
  padding: 4%;
  overflow-y: auto;
  background-color: rgba(26, 36, 55, 250);
  border: 2px solid #6c86aa;
  box-sizing: border-box;
}

h1 { font-size: 44dp; margin: 0 0 8dp 0; }
h2 { font-size: 30dp; margin: 0 0 24dp 0; }
p, .summary { font-size: 20dp; line-height: 30dp; }

h1, h2, p, .summary, .footer {
  display: block;
  background-color: transparent;
  border: none;
}

button {
  display: block;
  width: 100%;
  margin: 8dp 0;
  padding: 13dp 18dp;
  border: 2px solid #536b8e;
  background-color: #30445f;
  color: #f5f7fb;
  font-size: 22dp;
  text-align: left;
}

.mouse-active button:hover,
.controller-active button:focus {
  background-color: #5076a8;
  border-color: #d8e7ff;
  color: #ffffff;
}

button:disabled {
  color: #9aa7b8;
  background-color: #252f40;
  border-color: #3d4a5f;
}

.columns {
  display: flex;
  flex-direction: row;
  gap: 20dp;
}

.column { width: 50%; }
.warning { color: #ffd166; font-size: 18dp; }
.footer { margin-top: 20dp; color: #aebbd0; font-size: 16dp; }
