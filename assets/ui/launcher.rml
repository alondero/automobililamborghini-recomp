<rml>
  <head>
    <title>Automobili Lamborghini</title>
    <link type="text/rcss" href="lambo.rcss"/>
  </head>
  <body>
    <div id="window">
      <div class="panel">
        <h1>Automobili Lamborghini</h1>
        <h2>Recompiled</h2>
        <p>Configure your drive before entering the title screen.</p>
        <button id="autofocus" onclick="play">Play</button>
        <button onclick="page:settings">Settings</button>
        <button onclick="quit">Quit</button>
        <div id="version" class="footer">Loading version...</div>
      </div>
    </div>
  </body>
</rml>
